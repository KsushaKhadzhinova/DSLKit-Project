{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test labs/05-javascript-interactivity/auth-modules.test.js labs/05-javascript-interactivity/role-seal.test.js labs/05-javascript-interactivity/developer-role.test.js labs/05-javascript-interactivity/validation.test.js labs/05-javascript-interactivity/boundary.test.js labs/05-javascript-interactivity/docs.test.js labs/06-async-api-storage/storage-parser.test.js labs/06-async-api-storage/header-quotes.test.js labs/06-async-api-storage/engines.test.js"
  },
  "mutate": [
    "site/js/auth/{audit,bytes,lockout,password-policy,permissions,role-code,totp}.js",
    "site/js/utils/{dataParser,format-code,lang,markdown,node-position,validation}.js"
  ],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "ignorePatterns": [
    "/.claude",
    "/.git",
    "/part-2",
    "/course-project",
    "/react-app",
    "/materials",
    "/docs",
    "/paper-its",
    "/testing-course",
    "/dist",
    "/reports",
    "/coverage",
    "/labs/*/figures",
    "/labs/*/generated"
  ],
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 80, "low": 60, "break": 65 },
  "timeoutMS": 20000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
