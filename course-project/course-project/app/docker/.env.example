# Copy to .env and fill in. The real .env is never committed.
# Ready-made values are NOT provided on purpose.

# Optional mirror prefix for images when Docker Hub is blocked, with a trailing slash. Empty: Docker Hub.
# REGISTRY=mirror.gcr.io/
REGISTRY=

POSTGRES_USER=dslkit
POSTGRES_DB=dslkit
# Letters and digits only (the value goes into a connection URL).
POSTGRES_PASSWORD=

# At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# First administrator (optional): both values or none, the password needs 10 characters or more.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: a shared password (10 characters or more) for four demo users, demo diagrams and demo comments.
DEMO_USER_PASSWORD=

# Ports on the host.
FRONTEND_PORT=8080
BACKEND_PORT=3000

# Optional pgAdmin (docker compose --profile tools up -d pgadmin). Open http://localhost:5050, the server name is db.
# The password is required for the tool to start, letters and digits.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# Optional: a shared password (10 characters or more) for four demo users, demo diagrams and demo comments.
DEMO_USER_PASSWORD=
PGADMIN_PORT=5050
