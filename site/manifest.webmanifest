{
  "name": "DSLKit",
  "short_name": "DSLKit",
  "description": "Редактор диаграмм как кода: слева текст, справа диаграмма.",
  "lang": "ru",
  "start_url": "app/dashboard.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8f9fc",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "images/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "images/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "images/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "images/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
