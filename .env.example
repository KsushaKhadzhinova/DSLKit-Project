# Copy this file to .env on the server and fill in the values. Never commit .env.
# Скопируйте файл в .env на сервере и заполните. Никогда не коммитьте .env.

# The AI provider: anthropic (default) or openai (any OpenAI-compatible Chat Completions API, free ones included).
# ИИ-провайдер: anthropic (по умолчанию) или openai (любой OpenAI-совместимый API, в том числе бесплатный).
AI_PROVIDER=

# Provider anthropic: the key of the Claude API. Without a key the AI features are off.
# Провайдер anthropic: ключ Claude API. Без ключа ИИ выключен.
ANTHROPIC_API_KEY=

# Provider openai: the key and the https address of the API.
# Провайдер openai: ключ и https-адрес API (http только для localhost).
AI_API_KEY=
AI_BASE_URL=

# The model. For anthropic the default is claude-sonnet-5-5; for openai it is required.
# Модель. Для anthropic по умолчанию claude-sonnet-5-5; для openai обязательна.
AI_MODEL=

# The most AI requests per day for the whole server (default 200).
# Больше всего запросов к ИИ в сутки на весь сервер (по умолчанию 200).
AI_DAILY_LIMIT=
# The largest picture in megabytes (default 5).
# Самая большая картинка в мегабайтах (по умолчанию 5).
AI_MAX_IMAGE_MB=

# Ready free examples: copy ONE block into the lines above. PDF needs the anthropic provider.
# Готовые бесплатные примеры: скопируйте ОДИН блок в строки выше. PDF читает только провайдер anthropic.
#
# Google Gemini (recommended, free tier, reads pictures; key: https://aistudio.google.com/apikey)
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_API_KEY=<your Gemini key>
#   AI_MODEL=gemini-2.0-flash
#
# Groq (free, fast; key: https://console.groq.com/keys; choose a model with vision for pictures)
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_API_KEY=<your Groq key>
#   AI_MODEL=<a model from the Groq list>
#
# OpenRouter (a model with the :free ending; key: https://openrouter.ai/keys)
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=<your OpenRouter key>
#   AI_MODEL=<a model whose name ends with :free>
