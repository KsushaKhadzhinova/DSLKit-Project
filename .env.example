# Copy this file to .env on the server and fill in the values. Never commit .env.
# The key of the Claude API (Anthropic). Without it the AI features are off.
ANTHROPIC_API_KEY=
# The model; the default is claude-sonnet-5-5.
AI_MODEL=
# The most AI requests per day for the whole server.
AI_DAILY_LIMIT=
# The largest picture in megabytes.
AI_MAX_IMAGE_MB=

# --- docker compose (docker-compose.yml in the repository root) ---
POSTGRES_USER=dslkit
POSTGRES_PASSWORD=
POSTGRES_DB=dslkit
COURSE_POSTGRES_DB=dslkit_course
JWT_SECRET=
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
# Ports (change when one is already taken)
SITE_PORT=8090
POSTGRES_PORT=5432
MONGO_PORT=27017
LAB8_BACKEND_PORT=3001
LAB8_FRONTEND_PORT=8081
COURSE_BACKEND_PORT=3002
COURSE_FRONTEND_PORT=8082
# Optional mirror for images, ending with a slash
REGISTRY=
