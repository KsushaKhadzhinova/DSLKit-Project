# Copy this file to .env on the server and fill in the values. Never commit .env.
# The key of the Claude API (Anthropic). Without it the AI features are off.
ANTHROPIC_API_KEY=
# The model; the default is claude-sonnet-5-5.
AI_MODEL=
# The most AI requests per day for the whole server.
AI_DAILY_LIMIT=
# The largest picture in megabytes.
AI_MAX_IMAGE_MB=
