digraph G { rankdir=LR; node [fontname="Arial"];
s [label="" shape=circle width=0.4]; t1 [label="Receive\norder" shape=box style=rounded]; g [label="X" shape=diamond]; t2 [label="Pack" shape=box style=rounded]; t3 [label="Reject" shape=box style=rounded]; e [label="" shape=doublecircle width=0.4];
