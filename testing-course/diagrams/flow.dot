digraph G {
  rankdir=TB; dpi=130; nodesep=0.35; ranksep=0.4;
  node [fontname="Times New Roman", fontsize=13, shape=box, style="rounded,filled", fillcolor="#eef3ff", color="#335"];
  edge [fontname="Times New Roman", fontsize=12];
  start [label="Начало:\nоткрыта главная страница", shape=oval, fillcolor="#dff5df"];
  open [label="1. Нажать «В бету» →\nраздел #waitlist"];
  fill [label="2–7. Заполнить поля:\nимя, почта, нотация, команда,\nкомментарий, согласие"];
  send [label="8. Нажать «Отправить»"];
  dbl [label="Заявка уже\nотправлена?", shape=diamond, fillcolor="#fff6dd"];
  chk [label="9. validateWaitlist:\nпроверка по П1–П6", shape=box];
  ok [label="Есть неверные\nполя?", shape=diamond, fillcolor="#fff6dd"];
  err [label="A1, A2: показать ошибки,\nфокус на первое неверное поле", fillcolor="#ffe3e3"];
  rec [label="10. Очистить пробелы,\nсформировать запись\n{name, email, notation,\nteam, comment, createdAt}"];
  st [label="storage.set(\n'waitlist', записи)", shape=box];
  fail [label="E1: set вернул false —\nошибка не показывается", fillcolor="#ffe3e3"];
  nav [label="11. Открыть thanks.html"];
  end [label="Конец: заявка в LocalStorage,\nпосетитель на странице благодарности", shape=oval, fillcolor="#dff5df"];
  ign [label="A5: нажатие\nигнорируется", fillcolor="#eee"];
  start -> open -> fill -> send -> dbl;
  dbl -> ign [label="да"]; ign -> end [style=dashed];
  dbl -> chk [label="нет"];
  chk -> ok;
  ok -> err [label="да"]; err -> send [label="исправить", constraint=false];
  ok -> rec [label="нет"];
  rec -> st; st -> nav [label="записано"]; st -> fail [label="сбой", style=dashed]; fail -> nav [style=dashed];
  nav -> end;
}
