rap;spacing=0;" vertex="1" parent="1"><mxGeometry x="168" y="212" width="511" height="26.849999999999998" as="geometry"/></mxCell><mxCell id="c101" value="Клиенты" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=19;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="134" y="242" width="77" height="26.849999999999998" as="geometry"/></mxCell><mxCell id="c102" value="К1. Повысить удобство и удовлетворённость пользователей" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=19;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="168" y="272" width="530" height="26.849999999999998" as="geometry"/></mxCell><mxCell id="c103" value="К2. Увеличить число активных пользователей" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=19;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="168" y="302" width="407" height="26.849999999999998" as="geometry"/></mxCell><mxCell id="c104" value="К3. Увеличить долю платных пользователей Pro и Max" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=19;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="168" y="332" width="483" height="26.849999999999998" as="geometry"/></mxCell><mxCell id="c105" value="Внутренние бизнес-процессы" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=19;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="134" y="362" width="257" height="26.849999999999998" as="geometry"/></mxCell><mxCell id="c106" value="В1. Ускорить построение диаграммы" style="text;html=1;fillColor=none;strokeColor=none;fontFamily=Times New Roman;fontSize=19;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;" vertex="1" par