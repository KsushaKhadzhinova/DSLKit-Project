diagram dfd "Потоки данных"
entity Author "Автор"
process 1 "Разобрать код"
process 2 "Нарисовать"
entity Kroki "Сервис Kroki"
store D1 "Браузер: код"
store D2 "База данных"
process 3 "Сохранить запись"
flow Author -> 1 "текст"
flow 1 -> 2 "модель"
flow 2 -> Kroki "запрос"
flow Kroki -> 2 "SVG"
flow 1 -> D1 "автосохранение"
flow Author -> 3 "запись"
flow 3 -> D2 "строка"
