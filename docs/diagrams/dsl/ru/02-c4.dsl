diagram c4 "DSLKit: контейнеры"
person author "Автор диаграмм"
container editor "Редактор в браузере"
external kroki "Сервис Kroki"
container client "Клиент на React"
container proxy "Nginx"
container api "REST API на Express"
database db "PostgreSQL"
uses author -> editor "пишет код"
uses editor -> kroki "рисует"
uses author -> client "ведёт список"
uses client -> proxy "HTTP"
uses proxy -> api "/api"
uses api -> db "SQL"
