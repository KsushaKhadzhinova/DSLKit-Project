diagram dfd "Data flows"
entity Author "Author"
process 1 "Parse the code"
process 2 "Draw"
entity Kroki "Kroki service"
store D1 "Browser: code"
store D2 "Database"
process 3 "Save the record"
flow Author -> 1 "text"
flow 1 -> 2 "model"
flow 2 -> Kroki "request"
flow Kroki -> 2 "SVG"
flow 1 -> D1 "autosave"
flow Author -> 3 "record"
flow 3 -> D2 "row"
