diagram c4 "DSLKit: containers"
person author "Diagram author"
container editor "Editor in the browser"
external kroki "Kroki service"
container client "React client"
container proxy "Nginx"
container api "REST API on Express"
database db "PostgreSQL"
uses author -> editor "writes code"
uses editor -> kroki "draws"
uses author -> client "keeps a list"
uses client -> proxy "HTTP"
uses proxy -> api "/api"
uses api -> db "SQL"
