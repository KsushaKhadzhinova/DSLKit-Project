{
  "name": "dslkit-editor-server",
  "version": "1.0.0",
  "private": true,
  "description": "DSLKit editor server: accounts, roles and server-side project storage",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=97 --test-coverage-branches=93 --test-coverage-functions=97 \"tests/*.test.js\"",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
