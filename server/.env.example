# Copy to .env (never commit .env). Values below are placeholders.
NODE_ENV=development
PORT=4100
HOST=127.0.0.1

# sqlite (development, tests) or postgres (production, Docker)
DB_DIALECT=sqlite
DB_STORAGE=./data/dslkit.sqlite
# Used only when DB_DIALECT=postgres, e.g. postgres://user:pass@host:5432/dslkit
DATABASE_URL=
# Create tables automatically (true for sqlite/dev; use migrations in production)
DB_SYNC=true

# At least 32 random characters, generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# bcrypt cost, 10..15 in production
BCRYPT_ROUNDS=12

# Comma-separated allow-list of site origins
CORS_ORIGINS=http://localhost:5173

# Optional: create the first administrator at start when none exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
