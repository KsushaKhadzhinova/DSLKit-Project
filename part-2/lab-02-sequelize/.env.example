# Copy to .env and fill in. The real .env is never committed.
PORT=3000

# Local PostgreSQL from docker-compose.yml (docker compose up -d db). Letters and digits only, the value goes into a URL.
POSTGRES_USER=dslkit
POSTGRES_DB=dslkit
POSTGRES_PASSWORD=
DATABASE_URL=postgres://dslkit:<the same password>@localhost:5432/dslkit

# Neon, Supabase and other hosted servers need TLS:
# DATABASE_SSL=true
# Certificates are verified by default. Turn that off only for a server with a self-signed certificate:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Better: trust the server certificate authority (path to a PEM file) and keep the checks on:
# DATABASE_SSL_CA=./certs/ca.pem
# With NODE_ENV=production, DATABASE_SSL=true is required and the checks cannot be turned off.

# SQLite is used only when DATABASE_URL is empty and this is set (the tests do it with a temporary file):
# SQLITE_STORAGE=./dev.sqlite

# Port of the local database on this computer, change it if 5432 is taken (then change it in DATABASE_URL too).
# POSTGRES_PORT=5432
