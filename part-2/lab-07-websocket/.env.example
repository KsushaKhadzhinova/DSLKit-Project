# Copy to .env if you want to change the settings. The server works without it.
PORT=3000
# Extra sites (comma separated) that may open a socket besides the server's own address. Empty means same origin only.
# ALLOWED_ORIGINS=http://localhost:5173
# Secret for signing login tokens. Without it a local development value is used (never use that in production).
# TOKEN_SECRET=
# 1 refuses sockets that come without a login token.
# REQUIRE_TOKEN=1
# Connection string of MongoDB: with it the chat history is saved in the database. Without it the history is kept in memory.
# MONGODB_URI=
