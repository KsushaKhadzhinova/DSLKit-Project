# Copy to .env (not committed) and start with: node --env-file=.env src/server.js
PORT=3000
# SQLite file for the request log table; default is data/requests.db
DB_FILE=data/requests.db
# Only set this behind a reverse proxy that terminates HTTPS: the number of hops to trust (usually 1),
# an IP/subnet, or "true". Without it, req.secure, the cookie's Secure flag and HSTS never see HTTPS,
# because they would otherwise trust a header the proxy itself writes (X-Forwarded-Proto).
# TRUST_PROXY=1
