<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2563eb" />
    <title><%= title %> – DSLKit</title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/dslkit.css" />
    <link rel="stylesheet" href="/pz.css" />
    <script src="/theme.js"></script>
  </head>
  <body class="page">
    <a class="skip-link" href="#main">Skip to the main content</a>
    <header class="header">
      <div class="header__inner">
        <a class="header__logo" href="/<%= authQuery %>">
          <img class="header__logo-image" src="/images/logo.svg" alt="" width="32" height="32" />
          <span class="header__logo-text">DSLKit</span>
        </a>
        <input class="burger__input" type="checkbox" id="burger-toggle" />
        <label class="burger__button" for="burger-toggle">
          <span class="burger__label">Menu</span>
          <span class="burger__icon" aria-hidden="true"></span>
        </label>
        <nav class="nav" aria-label="Main navigation">
          <ul class="nav__list">
            <li class="nav__item"><a class="nav__link" href="/<%= authQuery %>"<%- path === '/' || path.startsWith('/item') ? ' aria-current="page"' : '' %>>Diagrams</a></li>
            <li class="nav__item"><a class="nav__link" href="/add<%= authQuery %>"<%- path === '/add' ? ' aria-current="page"' : '' %>>Add</a></li>
            <li class="nav__item"><a class="nav__link" href="/log<%= authQuery %>"<%- path === '/log' ? ' aria-current="page"' : '' %>>Request log</a></li>
            <% if (user.guest) { %>
              <li class="nav__item"><a class="nav__link" href="/login"<%- path === '/login' ? ' aria-current="page"' : '' %>>Sign in</a></li>
            <% } %>
          </ul>
        </nav>
        <div class="header__tools">
          <span class="header__user"><%= user.name %></span>
          <input class="theme__input" type="checkbox" id="theme-toggle" />
          <label class="theme__button" for="theme-toggle" data-tip="Dark theme"
            ><svg class="theme__icon theme__icon--moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg
            ><svg class="theme__icon theme__icon--sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              /></svg
            ><span class="theme__label">Dark theme</span></label
          >
        </div>
      </div>
    </header>
    <main class="main" id="main">
