<%- include('partials/header') %>
<section class="section" aria-labelledby="page-title">
  <h1 class="section__title" id="page-title"><%= heading %></h1>
  <p class="section__lead"><%= t('form.lead') %></p>
  <% const invalid = Object.keys(errors).length > 0; %>
  <form method="post" action="<%= action %><%= authQuery %>" class="form" novalidate>
    <% if (invalid) { %><p class="form__error" role="alert"><%= t('form.hasErrors') %></p><% } %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="form__field">
      <label class="form__label" for="title"><%= t('form.title') %></label>
      <input class="form__input" id="title" name="title" value="<%= values.title || '' %>" required maxlength="<%= limits.title.maxLength %>" autocomplete="off"<%- errors.title ? ' aria-invalid="true" aria-describedby="title-error"' : '' %> />
      <% if (errors.title) { %><p class="form__error" id="title-error"><%= errors.title %></p><% } %>
    </div>

    <div class="form__field">
      <label class="form__label" for="notation"><%= t('form.notation') %></label>
      <select class="form__input" id="notation" name="notation"<%- errors.notation ? ' aria-invalid="true" aria-describedby="notation-error"' : '' %>>
        <% notations.forEach((notation) => { %>
          <option value="<%= notation %>" <%= values.notation === notation ? 'selected' : '' %>><%= notation %></option>
        <% }) %>
      </select>
      <% if (errors.notation) { %><p class="form__error" id="notation-error"><%= errors.notation %></p><% } %>
    </div>

    <div class="form__field">
      <label class="form__label" for="description"><%= t('form.description') %></label>
      <textarea class="form__input" id="description" name="description" rows="3" required maxlength="<%= limits.description.maxLength %>"<%- errors.description ? ' aria-invalid="true" aria-describedby="description-error"' : '' %>><%= values.description || '' %></textarea>
      <p class="form__hint"><%= t('form.descriptionHint', { max: limits.description.maxLength }) %></p>
      <% if (errors.description) { %><p class="form__error" id="description-error"><%= errors.description %></p><% } %>
    </div>

    <div class="form__field">
      <label class="form__label" for="code"><%= t('form.code') %></label>
      <textarea class="form__input" id="code" name="code" rows="6" maxlength="<%= limits.code.maxLength %>"<%- errors.code ? ' aria-invalid="true" aria-describedby="code-error"' : '' %>><%= values.code || '' %></textarea>
      <p class="form__hint"><%= t('form.codeHint', { max: limits.code.maxLength }) %></p>
      <% if (errors.code) { %><p class="form__error" id="code-error"><%= errors.code %></p><% } %>
    </div>

    <div class="form__field">
      <label class="form__label" for="revision"><%= t('form.revision') %></label>
      <input class="form__input" id="revision" name="revision" type="number" inputmode="numeric" step="1" min="<%= limits.revision.min %>" max="<%= limits.revision.max %>" value="<%= values.revision || '' %>" required<%- errors.revision ? ' aria-invalid="true" aria-describedby="revision-error"' : '' %> />
      <% if (errors.revision) { %><p class="form__error" id="revision-error"><%= errors.revision %></p><% } %>
    </div>

    <button class="button button--primary form__submit" type="submit"><%= submit %></button>
  </form>
</section>
<%- include('partials/footer') %>
