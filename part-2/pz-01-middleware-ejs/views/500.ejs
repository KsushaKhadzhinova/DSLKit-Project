<%- include('partials/header') %>
<section class="error" aria-labelledby="page-title">
  <p class="error__code"><%= t('error.codeLabel') %> <%= status %></p>
  <h1 class="error__title" id="page-title"><%= heading %></h1>
  <h2 class="error__heading"><%= t('error.whatHeading') %></h2>
  <p class="error__text"><%= what %></p>
  <% if (message) { %><p class="error__notice" role="alert"><%= message %></p><% } %>
  <h2 class="error__heading"><%= t('error.whyHeading') %></h2>
  <ul class="error__list"><% why.forEach((item) => { %><li><%= item %></li><% }) %></ul>
  <h2 class="error__heading"><%= t('error.fixHeading') %></h2>
  <ol class="error__list error__list--steps"><% fix.forEach((item) => { %><li><%= item %></li><% }) %></ol>
  <a class="button button--primary" href="/<%= authQuery %>"><%= t('error.backToList') %></a>
</section>
<%- include('partials/footer') %>
