# Copy to .env. Without DATABASE_URL the app uses a local SQLite file (no install needed).
PORT=3000

# PostgreSQL / Neon / Supabase. Leave empty to use SQLite.
# DATABASE_URL=postgres://user:password@localhost:5432/dslkit
# Neon and Supabase need TLS:
# DATABASE_SSL=true
# Certificates are verified by default. Turn that off only for a server with a self-signed certificate:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Better: trust the server certificate authority (path to a PEM file) and keep the checks on:
# DATABASE_SSL_CA=./certs/ca.pem
# With NODE_ENV=production, DATABASE_SSL=true is required and the checks cannot be turned off.

# SQLite file used when DATABASE_URL is empty
SQLITE_STORAGE=./dev.sqlite

# Secret that signs JWTs: at least 32 random characters, never commit the real one. The server refuses to start with a weaker one.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime: seconds or 15m, 1h, 1d. At most 24 hours.
JWT_EXPIRES_IN=1h

# First administrator, created by "npm run db:seed". Leave empty to skip. The password needs 10 characters or more.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 1 when exactly one reverse proxy stands in front of the server, otherwise the rate limit sees the proxy address.
# TRUST_PROXY=1

# Four ordinary demo users (alice, bob, carol, dave @example.test) that share this password and own the demo diagrams. Leave empty to skip.
DEMO_USER_PASSWORD=
