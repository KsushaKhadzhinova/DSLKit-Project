# Copy to .env. Without DATABASE_URL the app uses a local SQLite file (no install needed).
PORT=3000

# PostgreSQL / Neon / Supabase. Leave empty to use SQLite.
# DATABASE_URL=postgres://user:password@localhost:5432/dslkit
# Neon and Supabase need TLS:
# DATABASE_SSL=true

# SQLite file used when DATABASE_URL is empty
SQLITE_STORAGE=./dev.sqlite

# Secret that signs JWTs: at least 32 random characters, never commit the real one.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# First administrator, created by "npm run db:seed". Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
