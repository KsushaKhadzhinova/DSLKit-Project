# Copy to .env. Never commit .env.
PORT=3000
# MONGO_URI is accepted as an alias of MONGODB_URI.

# Local MongoDB Community Edition:
MONGODB_URI=mongodb://127.0.0.1:27017/dslkit
# MongoDB Atlas (M0): paste the connection string from "Connect > Drivers", with your database user and password:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dslkit?retryWrites=true&w=majority
